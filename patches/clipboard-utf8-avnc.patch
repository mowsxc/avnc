@@ -0,0 +1,96 @@
+/*
+ * Copyright (c) 2024  Gaurav Ujjwal.
+ *
+ * SPDX-License-Identifier:  GPL-3.0-or-later
+ *
+ * See COPYING.txt for more details.
+ */
+
+package com.gaurav.avnc.util
+
+import java.nio.ByteBuffer
+import java.nio.charset.CharacterCodingException
+import java.nio.charset.Charset
+import java.nio.charset.CodingErrorAction
+import java.nio.charset.StandardCharsets
+
+/**
+ * Encoding used to decode a legacy clipboard frame (a frame that carries
+ * no charset information on the wire).
+ */
+enum class LegacyEncoding { UTF8, GBK, LATIN1 }
+
+/**
+ * Result of a legacy clipboard decode: the text plus the encoding that
+ * produced it. The encoding doubles as the "hint" for the next frame: a
+ * server is consistent, so the charset learned from one frame almost
+ * always applies to the next one.
+ */
+data class Decoded(val text: String, val encoding: LegacyEncoding)
+
+/**
+ * Decodes clipboard payloads that arrive without a charset tag.
+ *
+ * Legacy VNC ServerCutText/ClientCutText frames carry plain bytes only.
+ * Western servers send Latin-1, TightVNC (and most zh-CN setups) send the
+ * ANSI codepage — GBK on Chinese Windows — and some servers just dump
+ * UTF-8 bytes into the legacy frame. This codec picks the best
+ * interpretation:
+ *
+ *  1. If a hint learned from a previous frame matches, use it.
+ *  2. Otherwise try strict UTF-8; accept only when the result contains no
+ *     C1 controls (U+0080–U+009F). GBK byte pairs frequently decode as
+ *     "valid" UTF-8 landing in that range, so C1 presence means "probably
+ *     GBK, not UTF-8".
+ *  3. Otherwise try strict GBK.
+ *  4. Fall back to ISO-8859-1, which never fails.
+ *
+ * Known residual ambiguity: a lone GBK pair that is itself valid UTF-8
+ * outside the C1 range (e.g. D1 A7 = GBK 学 vs U+0467) cannot be told
+ * apart from real UTF-8 on the first frame. The learned hint resolves it
+ * from the second frame on; single-character first frames are an
+ * accepted trade-off.
+ */
+object ClipboardCodec {
+
+    /** GBK when available; Chinese Windows is the common target. */
+    val GBK: Charset? = runCatching { Charset.forName("GBK") }
+        .recoverCatching { Charset.forName("GB18030") }
+        .getOrNull()
+
+    /** Strict single decode: REPORT on malformed input, null on failure. */
+    private fun decodeStrict(bytes: ByteArray, charset: Charset): String? = try {
+        charset.newDecoder()
+            .onMalformedInput(CodingErrorAction.REPORT)
+            .onUnmappableCharacter(CodingErrorAction.REPORT)
+            .decode(ByteBuffer.wrap(bytes))
+            .toString()
+    } catch (_: CharacterCodingException) {
+        null
+    }
+
+    fun decodeUtf8Strict(bytes: ByteArray): String? = decodeStrict(bytes, StandardCharsets.UTF_8)
+
+    /** Convenience: decode without a hint. */
+    fun decode(bytes: ByteArray): String = decodeWithHint(bytes, null).text
+
+    fun decodeWithHint(bytes: ByteArray, hint: LegacyEncoding? = null): Decoded {
+        if (bytes.isEmpty()) return Decoded("", hint ?: LegacyEncoding.UTF8)
+        if (hint != null) {
+            val charset = when (hint) {
+                LegacyEncoding.UTF8 -> StandardCharsets.UTF_8
+                LegacyEncoding.GBK -> GBK ?: StandardCharsets.UTF_8
+                LegacyEncoding.LATIN1 -> StandardCharsets.ISO_8859_1
+            }
+            decodeStrict(bytes, charset)?.let { return Decoded(it, hint) }
+        }
+        decodeUtf8Strict(bytes)?.let { utf8 ->
+            if (utf8.none { it.code in 0x80..0x9F }) return Decoded(utf8, LegacyEncoding.UTF8)
+        }
+        GBK?.let { gbk ->
+            decodeStrict(bytes, gbk)?.let { return Decoded(it, LegacyEncoding.GBK) }
+        }
+        return Decoded(StandardCharsets.ISO_8859_1.decode(ByteBuffer.wrap(bytes)).toString(),
+            LegacyEncoding.LATIN1)
+    }
+}
