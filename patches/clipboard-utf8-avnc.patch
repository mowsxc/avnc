diff --git a/app/src/test/java/com/gaurav/avnc/util/ClipboardCodecTest.kt b/app/src/test/java/com/gaurav/avnc/util/ClipboardCodecTest.kt
new file mode 100644
index 0000000..35fea69
--- /dev/null
+++ b/app/src/test/java/com/gaurav/avnc/util/ClipboardCodecTest.kt
@@ -0,0 +1,179 @@
+/*
+ * Copyright (c) 2024  Gaurav Ujjwal.
+ *
+ * SPDX-License-Identifier:  GPL-3.0-or-later
+ *
+ * See COPYING.txt for more details.
+ */
+
+package com.gaurav.avnc.util
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.nio.charset.Charset
+import java.nio.charset.StandardCharsets
+
+/**
+ * Plain JVM unit tests for [ClipboardCodec] (`app/build.gradle.kts` already has
+ * `testImplementation("junit:junit:4.13.2")`, so no new dependency is needed).
+ *
+ * Chinese/emoji literals are written as `\uXXXX` escapes on purpose: the byte
+ * tables then do not depend on the encoding the compiler happens to read this
+ * file with.
+ */
+class ClipboardCodecTest {
+
+    private val gbk: Charset = Charset.forName("GBK")
+
+    /** 「你好，世界」 */
+    private val chinese = "\u4F60\u597D\uFF0C\u4E16\u754C"
+
+    /** 「中文😀」 — U+4E2D U+6587 U+1F600 (D83D DE00 surrogate pair) */
+    private val chineseWithEmoji = "\u4E2D\u6587\uD83D\uDE00"
+
+    @Test
+    fun utf8ChineseRoundTrips() {
+        val bytes = chinese.toByteArray(StandardCharsets.UTF_8)
+        assertEquals(chinese, ClipboardCodec.decode(bytes))
+    }
+
+    @Test
+    fun gbkByteTableIsStable() {
+        // CP936 for 「你好，世界」 — verified against Python's `gbk` codec.
+        val expected = byteArrayOf(
+            0xC4.toByte(), 0xE3.toByte(),
+            0xBA.toByte(), 0xC3.toByte(),
+            0xA3.toByte(), 0xAC.toByte(),
+            0xCA.toByte(), 0xC0.toByte(),
+            0xBD.toByte(), 0xE7.toByte()
+        )
+        assertArrayEquals(expected, chinese.toByteArray(gbk))
+    }
+
+    @Test
+    fun gbkChineseRoundTrips() {
+        val bytes = chinese.toByteArray(gbk)
+        assertEquals(chinese, ClipboardCodec.decode(bytes))
+    }
+
+    @Test
+    fun gbkBytesAreNotValidUtf8() {
+        // Guards the ordering assumption: if these bytes ever became valid
+        // UTF-8, strict-UTF-8-first would mojibake them.
+        assertNull(ClipboardCodec.decodeUtf8Strict(chinese.toByteArray(gbk)))
+    }
+
+    @Test
+    fun asciiRoundTrips() {
+        val text = "Hello 123"
+        assertEquals(text, ClipboardCodec.decode(text.toByteArray(StandardCharsets.US_ASCII)))
+    }
+
+    @Test
+    fun emptyBytesGiveEmptyString() {
+        assertEquals("", ClipboardCodec.decode(ByteArray(0)))
+        assertEquals("", ClipboardCodec.decodeUtf8Strict(ByteArray(0)))
+    }
+
+    @Test
+    fun singleHighByteFallsBackToLatin1() {
+        // 0xE9 alone: invalid UTF-8 (truncated lead) and invalid GBK (lead byte
+        // with no trail byte) -> ISO-8859-1 gives "é".
+        assertEquals("\u00E9", ClipboardCodec.decode(byteArrayOf(0xE9.toByte())))
+    }
+
+    @Test
+    fun illegalBytesDoNotThrowAndUseLatin1Fallback() {
+        val bytes = byteArrayOf(0xFF.toByte(), 0xFE.toByte(), 0x80.toByte())
+        val text = ClipboardCodec.decode(bytes)
+        assertNotNull(text)
+        assertFalse(text.isEmpty())
+        assertEquals(3, text.length)
+        assertEquals("\u00FF\u00FE\u0080", text)
+        assertNull(ClipboardCodec.decodeUtf8Strict(bytes))
+    }
+
+    @Test
+    fun utf8ChineseWithEmojiRoundTrips() {
+        val bytes = chineseWithEmoji.toByteArray(StandardCharsets.UTF_8)
+        assertEquals(chineseWithEmoji, ClipboardCodec.decode(bytes))
+        // 2 CJK chars * 3 bytes + 1 emoji * 4 bytes
+        assertEquals(10, bytes.size)
+    }
+
+    @Test
+    fun decodeUtf8StrictReturnsTextForValidUtf8() {
+        val text = ClipboardCodec.decodeUtf8Strict(chinese.toByteArray(StandardCharsets.UTF_8))
+        assertEquals(chinese, text)
+    }
+
+    @Test
+    fun decodeIsLosslessForEveryByteValueExceptTrailingNulFreeStrings() {
+        // Full 0x00..0xFF sweep must never throw; Latin-1 fallback keeps the
+        // character count identical to the byte count when nothing else fits.
+        val bytes = ByteArray(256) { it.toByte() }
+        val text = ClipboardCodec.decode(bytes)
+        assertTrue(text.isNotEmpty())
+    }
+
+    @Test
+    fun singleCharGbkWithLearnedHint() {
+        val d = ClipboardCodec.decodeWithHint(byteArrayOf(0xD1.toByte(), 0xA7.toByte()), LegacyEncoding.GBK)
+        assertEquals("学", d.text)
+        assertEquals(LegacyEncoding.GBK, d.encoding)
+    }
+
+    @Test
+    fun hintBeatsUtf8OnAmbiguousPair() {
+        // 时 = CAB1 本身也是合法 UTF-8 (U+02B1)，学到的 GBK hint 必须优先。
+        val d = ClipboardCodec.decodeWithHint(byteArrayOf(0xCA.toByte(), 0xB1.toByte()), LegacyEncoding.GBK)
+        assertEquals("时", d.text)
+    }
+
+    @Test
+    fun gbkPhraseAutoDetectedWithoutHint() {
+        val d = ClipboardCodec.decodeWithHint(
+            byteArrayOf(0xC4.toByte(), 0xE3.toByte(), 0xBA.toByte(), 0xC3.toByte(),
+                0xA3.toByte(), 0xAC.toByte(), 0xCA.toByte(), 0xC0.toByte(), 0xBD.toByte(), 0xE7.toByte()),
+            null)
+        assertEquals("你好，世界", d.text)
+        assertEquals(LegacyEncoding.GBK, d.encoding)
+    }
+
+    @Test
+    fun c1FilterRejectsAmbiguousUtf8() {
+        // C2 80 是合法 UTF-8 (U+0080，真正的 C1 控制区) 但真实 UTF-8 文本几乎
+        // 不可能包含 C1 控制符；作为 GBK 字节对 (C2 80) 却是常见汉字。C1 过滤
+        // 应拒绝 UTF-8 解读并改走 GBK（设计取舍，见 ClipboardCodec KDoc）。
+        val d = ClipboardCodec.decodeWithHint(byteArrayOf(0xC2.toByte(), 0x80.toByte()), null)
+        assertEquals(LegacyEncoding.GBK, d.encoding)
+    }
+
+    @Test
+    fun latin1FallbackOnLoneHighByte() {
+        val d = ClipboardCodec.decodeWithHint(byteArrayOf(0x63, 0x61, 0x66, 0xE9.toByte()), null)
+        assertEquals("café", d.text)
+        assertEquals(LegacyEncoding.LATIN1, d.encoding)
+    }
+
+    @Test
+    fun knownAmbiguityDocumentedForSingleCharGbk() {
+        // D1 A7 是合法 UTF-8 (U+0467)。无 hint 时无法知道它是 GBK 的「学」，
+        // 这是记录在案的残余歧义；真机连接中学到 GBK hint 后即正确。
+        val d = ClipboardCodec.decodeWithHint(byteArrayOf(0xD1.toByte(), 0xA7.toByte()), null)
+        assertEquals("\u0467", d.text)
+        assertEquals(LegacyEncoding.UTF8, d.encoding)
+    }
+
+    @Test
+    fun emptyPayloadKeepsHint() {
+        assertEquals("", ClipboardCodec.decodeWithHint(ByteArray(0), null).text)
+        assertEquals(LegacyEncoding.GBK, ClipboardCodec.decodeWithHint(ByteArray(0), LegacyEncoding.GBK).encoding)
+    }
+
+}
