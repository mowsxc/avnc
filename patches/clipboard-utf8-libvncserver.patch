+/*
+ * SendTightEnableCutTextUTF8.
+ *
+ * Sends the 4-byte ENABLE_CUT_TEXT_UTF8 (0xFC000201) message of the
+ * TightVNC private clipboard extension.  There is no payload and no length
+ * field: the server dispatcher recognizes the 0xFC prefix, reassembles the
+ * 32 bit id and flips its internal "utf8 clipboard" flag.  Only valid for
+ * servers that advertised rfbTight (16); 0xFC is an unknown message id for
+ * every other server and would tear the connection down.
+ */
+
+rfbBool
+SendTightEnableCutTextUTF8(rfbClient* client)
+{
+  const uint8_t msg[4] = {
+    (uint8_t)(rfbTightEnableCutTextUTF8 >> 24),
+    (uint8_t)(rfbTightEnableCutTextUTF8 >> 16),
+    (uint8_t)(rfbTightEnableCutTextUTF8 >> 8),
+    (uint8_t)(rfbTightEnableCutTextUTF8)
+  };
+
+  if (!client->tightCutTextUTF8Available)
+    return FALSE;
+
+  return WriteToRFBServer(client, (const char *)msg, (unsigned int)sizeof(msg));
+}
+
+/*
+ * SendTightClientCutTextUTF8.
+ *
+ * Sends CLIENT_CUT_TEXT_UTF8 (0xFC000200) followed by a big-endian uint32
+ * byte count and the raw UTF-8 bytes (no terminating NUL).  The length is
+ * assembled by hand so it does not depend on rfbClientSwap32IfLE().
+ */
+
+rfbBool
+SendTightClientCutTextUTF8(rfbClient* client, const char* str, int len)
+{
+    if (!client || !client->tightCutTextUTF8Available)
+        return FALSE;
+    if (len < 0 || len > (1 << 20))
+        return FALSE;
+    if (len > 0 && !str)
+        return FALSE;
+
+    /* Single write: WriteToRFBServer() is not locked on the plain socket
+     * path, so a header+payload two-call sequence could interleave with
+     * the session thread and corrupt the stream. */
+    rfbBool ok;
+    char *buf = (char *)malloc(8 + (size_t)len);
+    if (!buf)
+        return FALSE;
+    buf[0] = 0xFC;
+    buf[1] = 0x00;
+    buf[2] = 0x02;
+    buf[3] = 0x00;
+    buf[4] = (char)((len >> 24) & 0xFF);
+    buf[5] = (char)((len >> 16) & 0xFF);
+    buf[6] = (char)((len >> 8) & 0xFF);
+    buf[7] = (char)(len & 0xFF);
+    if (len > 0)
+        memcpy(buf + 8, str, len);
+    ok = WriteToRFBServer(client, buf, 8 + len);
+    free(buf);
+    return ok;
+}
